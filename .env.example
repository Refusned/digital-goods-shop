PORT=3020
DATABASE_URL=postgres://shop:shop@localhost:5443/shop

# Фоновая доводка "зависших" заказов
WORKER_ENABLED=1
WORKER_INTERVAL_MS=1000
OUT_OF_STOCK_RETRY_MS=3000

# Токен админки (простой, как разрешает задание). Пустое значение = админка без токена.
ADMIN_TOKEN=admin-token

# --- Второй этап -------------------------------------------------------------
# Бронь ключа под заказ: сколько времени даётся на оформление и на оплату
RESERVATION_TTL_MS=300000
RESERVATION_PAYMENT_TTL_MS=180000

# Живые обновления витрины (LISTEN/NOTIFY -> Server-Sent Events)
LIVE_UPDATES_ENABLED=1
LIVE_BATCH_MS=80
LIVE_HEARTBEAT_MS=15000
